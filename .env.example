# Neon / Lakebase Postgres (claim via neon.new if expired)
DATABASE_URL=postgresql://USER:PASS@HOST/neondb?sslmode=require
# Client API prefix (Netlify redirects /api/* → functions)
VITE_SYNC_API=/api
# Phantom Portal app ID (optional — enables Google/Apple; injected works without)
VITE_PHANTOM_APP_ID=
VITE_PHANTOM_REDIRECT_URL=https://chaindrone.netlify.app/
# WalletConnect / Reown Cloud project ID (QR + mobile wallets)
VITE_WALLETCONNECT_PROJECT_ID=6f704759b7faa449ccbf5fdf9d2d4eb5
