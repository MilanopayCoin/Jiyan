# Neon / Lakebase Postgres (claim via neon.new if expired)
DATABASE_URL=postgresql://USER:PASS@HOST/neondb?sslmode=require
# Client API prefix (Netlify redirects /api/* → functions)
VITE_SYNC_API=/api
# Phantom Portal app ID (optional — enables Google/Apple; injected works without)
VITE_PHANTOM_APP_ID=
VITE_PHANTOM_REDIRECT_URL=https://chaindrone.netlify.app/
# WalletConnect / Reown Cloud project ID (QR + mobile wallets)
VITE_WALLETCONNECT_PROJECT_ID=6f704759b7faa449ccbf5fdf9d2d4eb5
# Solana on-chain deposits (Phantom → treasury)
# cluster: devnet | mainnet-beta
VITE_SOLANA_CLUSTER=devnet
# Optional custom RPC; defaults to public cluster endpoint
VITE_SOLANA_RPC=
# Treasury public key that receives SOL / USDC deposits
VITE_SOLANA_TREASURY=
# Optional USDC mint override (defaults: mainnet Circle / devnet Circle)
VITE_USDC_MINT=
# Fee-payer public key for gasless USDC (must match server SPONSOR_PRIVATE_KEY)
VITE_SOLANA_SPONSOR_PUBKEY=
# Server-only (Netlify env, never VITE_*): base58 secret for /api/sponsor
# SPONSOR_PRIVATE_KEY=
# Telegram Mini App bot username (without @) for startapp invite links
VITE_TELEGRAM_BOT_USERNAME=
# Server-only: Bot API token for Stars invoices (createInvoiceLink)
# TELEGRAM_BOT_TOKEN=
